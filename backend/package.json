{
  "name": "@sgh/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "create-super-admin": "tsx --env-file-if-exists=.env scripts/create-super-admin.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@aws-sdk/client-s3": "3.1175.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@node-rs/argon2": "2.2.2",
    "@sgh/shared": "workspace:*",
    "bullmq": "6.7.8",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "file-type": "22.3.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "6.2.18",
    "mongoose": "9.12.3",
    "multer": "2.5.0",
    "nodemailer": "10.6.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "rate-limiter-flexible": "11.5.0",
    "sanitize-html": "2.18.2",
    "sharp": "0.35.5",
    "swagger-ui-express": "5.0.1",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "9.39.5",
    "mongodb-memory-server": "11.4.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
