# Copy to backend/.env for local development. Never commit real values.
NODE_ENV=development
SITE_ENV=local
PORT=4000
SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/sgh_dev
REDIS_URL=redis://127.0.0.1:6379
# openssl rand -base64 48
HASH_SECRET=
# openssl rand -base64 32   (must decode to exactly 32 bytes)
ENCRYPTION_KEY=
# openssl rand -base64 48   (same value in frontend REVALIDATE_SECRET)
REVALIDATE_SECRET=
REVALIDATE_URL=http://localhost:3000/api/revalidate
LOG_LEVEL=debug
# Media storage (S3 or S3-compatible such as MinIO for local dev)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
MEDIA_PUBLIC_BASE_URL=
# Email (leave empty in dev: emails are logged instead)
SMTP_URL=
MAIL_FROM=Shivanshi Gaming Hub <no-reply@shivanshigaming.com>
