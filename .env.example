# Copy to frontend/.env.local (frontend) — never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Internal URL the Next.js server uses to reach the API (M3+)
API_INTERNAL_URL=http://localhost:4000/api/v1
# HMAC secret shared with the backend for on-demand revalidation (M3+)
REVALIDATE_SECRET=
