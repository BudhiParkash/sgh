# Production backend env — stored in AWS SSM Parameter Store as SecureString (/sgh/prod/backend/*),
# written to /srv/sgh/shared/backend.env (mode 0600) by deploy.sh. NEVER commit real values.
NODE_ENV=production
SITE_ENV=production
PORT=4000
TRUST_PROXY=1
SITE_URL=https://shivanshigaming.com
CORS_ORIGINS=https://shivanshigaming.com
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sgh?retryWrites=true&w=majority
REDIS_URL=redis://:<password>@127.0.0.1:6379
HASH_SECRET=<openssl rand -base64 48>
ENCRYPTION_KEY=<openssl rand -base64 32>
REVALIDATE_SECRET=<openssl rand -base64 48 — same as frontend>
REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate
LOG_LEVEL=info
S3_BUCKET=media.shivanshigaming.com
S3_REGION=ap-south-1
MEDIA_PUBLIC_BASE_URL=https://media.shivanshigaming.com
SMTP_URL=smtps://<ses-smtp-user>:<ses-smtp-password>@email-smtp.ap-south-1.amazonaws.com:465
MAIL_FROM=Shivanshi Gaming Hub <no-reply@shivanshigaming.com>
TURNSTILE_SECRET=<cloudflare turnstile secret>
INDEXNOW_KEY=<random 32 chars>
