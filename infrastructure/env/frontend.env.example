# Production frontend env (build-time + runtime). Stored in SSM (/sgh/prod/frontend/*).
NODE_ENV=production
SITE_ENV=production
NEXT_PUBLIC_SITE_URL=https://shivanshigaming.com
NEXT_PUBLIC_MEDIA_ORIGIN=https://media.shivanshigaming.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<cloudflare turnstile site key>
API_INTERNAL_URL=http://127.0.0.1:4000/api/v1
REVALIDATE_SECRET=<same as backend>
INDEXNOW_KEY=<same as backend>
# Google sign-in for player accounts (OAuth Web client id; same value as backend GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com
