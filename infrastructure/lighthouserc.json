{
  "ci": {
    "collect": {
      "startServerCommand": "bash infrastructure/scripts/e2e-backend.sh & cd frontend && SITE_ENV=production pnpm exec next start --port 3100",
      "startServerReadyPattern": "Ready",
      "url": ["http://localhost:3100/", "http://localhost:3100/sensitivity", "http://localhost:3100/tournaments/upcoming", "http://localhost:3100/news", "http://localhost:3100/contact"],
      "numberOfRuns": 3,
      "settings": { "formFactor": "mobile", "chromeFlags": "--headless=new --no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["warn", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300, "aggregationMethod": "median-run" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "frontend/test-results/lighthouse" }
  }
}
